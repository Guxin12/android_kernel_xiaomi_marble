#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# 并行迁移脚本（修复参数解析，支持：自定义起点 SHA、并行推送、repack）
# ============================================================

LOG_FILE="../migration.log"
STATE_FILE="../.migrate_state"

# 默认参数（可通过命令行覆盖）
BATCH_SIZE=100000
MAX_RETRY=10
BASE_BACKOFF=5
JOBS=8
DO_REPACK=true

log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOG_FILE"; }

usage() {
  cat <<EOF
用法：
  $0 <new-remote> <target-branch> [start-sha] [--jobs N] [--batch-size M] [--repack true|false]

说明：
  - start-sha 可选。如果提供，则从该 SHA（包含）开始推送；如果不提供，从头开始或根据断点恢复。
  - 参数顺序不强制，示例：
      $0 origin mybranch --jobs 8 --batch-size 100000 --repack true
      $0 origin mybranch 648e13791 --jobs 4 --batch-size 200000 --repack false
EOF
}

if [ $# -lt 2 ]; then usage; exit 1; fi

# 必填位置参数
NEW_REMOTE="$1"
TARGET_BRANCH="$2"
shift 2

# 可选位置参数：第一个非 -- 开头的参数视为 start-sha
USER_START_SHA=""
if [[ $# -gt 0 && ! "$1" == --* ]]; then
  USER_START_SHA="$1"
  shift
fi

# 解析命名参数（顺序任意）
while [[ $# -gt 0 ]]; do
  case "$1" in
    --jobs)
      if [[ -z "${2:-}" ]]; then echo "错误：--jobs 需要一个数值参数"; exit 1; fi
      JOBS="$2"; shift 2 ;;
    --batch-size)
      if [[ -z "${2:-}" ]]; then echo "错误：--batch-size 需要一个数值参数"; exit 1; fi
      BATCH_SIZE="$2"; shift 2 ;;
    --repack)
      if [[ -z "${2:-}" ]]; then echo "错误：--repack 需要 true|false"; exit 1; fi
      DO_REPACK="$2"; shift 2 ;;
    --help|-h)
      usage; exit 0 ;;
    *)
      echo "警告：忽略未知选项 $1"
      shift ;;
  esac
done

# 基本类型校验
if ! [[ "$JOBS" =~ ^[0-9]+$ ]]; then
  echo "错误：--jobs 必须为正整数（当前：$JOBS）"; exit 1
fi
if ! [[ "$BATCH_SIZE" =~ ^[0-9]+$ ]]; then
  echo "错误：--batch-size 必须为正整数（当前：$BATCH_SIZE）"; exit 1
fi
if ! [[ "$DO_REPACK" =~ ^(true|false|True|False|1|0)$ ]]; then
  echo "错误：--repack 只接受 true 或 false（当前：$DO_REPACK）"; exit 1
fi

: > "$LOG_FILE"
log "启动并行迁移：origin -> $NEW_REMOTE/$TARGET_BRANCH"
log "参数：BATCH_SIZE=$BATCH_SIZE | JOBS=$JOBS | REPACK=$DO_REPACK | start-sha=${USER_START_SHA:-<none>}"

# 基础检查
git rev-parse --is-inside-work-tree >/dev/null || { log "错误：不是 Git 仓库"; exit 1; }
git remote get-url origin >/dev/null 2>&1 || { log "错误：缺少 origin"; exit 1; }
git remote get-url "$NEW_REMOTE" >/dev/null 2>&1 || { log "错误：缺少 $NEW_REMOTE"; exit 1; }

# 可选：先 repack，把对象合并，减少每次传输数据量
if [[ "$DO_REPACK" == "true" || "$DO_REPACK" == "True" || "$DO_REPACK" == "1" ]]; then
  log "开始 repack（可能需要几分钟到几十分钟，取决于对象数量）..."
  # 先做非 aggressive repack（通常足够且速度更快），失败不致命
  if git repack -a -d --depth=250 --window=250 >>"$LOG_FILE" 2>&1; then
    log "repack 完成"
  else
    log "repack 失败（非致命），继续"
  fi
fi

# fetch origin refs
log "获取 origin 引用..."
git fetch origin --prune 2>&1 | tee -a "$LOG_FILE" || log "fetch origin 失败，使用本地引用"

# 选择 origin 引用
if git show-ref --verify --quiet refs/remotes/origin/HEAD; then
  ORIGIN_REF="origin/HEAD"
elif git show-ref --verify --quiet refs/remotes/origin/main; then
  ORIGIN_REF="origin/main"
elif git show-ref --verify --quiet refs/remotes/origin/master; then
  ORIGIN_REF="origin/master"
else
  ORIGIN_REF="HEAD"
fi

# 构建提交列表（从 oldest 到 newest）
mapfile -t ALL_COMMITS < <(git rev-list --reverse "$ORIGIN_REF")
TOTAL=${#ALL_COMMITS[@]}
log "共发现 $TOTAL 条提交记录"

# 计算起始索引
START_INDEX=0
if [ -n "$USER_START_SHA" ]; then
  log "用户指定起点 SHA：$USER_START_SHA"
  FOUND=0
  for i in "${!ALL_COMMITS[@]}"; do
    if [[ "${ALL_COMMITS[$i]}" = "$USER_START_SHA" ]]; then
      START_INDEX="$i"
      FOUND=1
      break
    fi
  done
  if (( FOUND == 0 )); then
    log "错误：找不到指定 SHA：$USER_START_SHA"; exit 1
  fi
else
  # 恢复断点（若存在）
  if [ -f "$STATE_FILE" ]; then
    LAST_COMMIT=$(cat "$STATE_FILE" | tr -d " \n\r")
    if [ -n "$LAST_COMMIT" ]; then
      for i in "${!ALL_COMMITS[@]}"; do
        if [[ "${ALL_COMMITS[$i]}" = "$LAST_COMMIT" ]]; then
          START_INDEX=$(( i + 1 ))
          log "断点恢复：上次完成 commit $LAST_COMMIT（索引 $i）"
          break
        fi
      done
    fi
  fi
fi

# 构造要推送的提交数组（只取起点之后）
COMMITS_TO_PUSH=("${ALL_COMMITS[@]:$START_INDEX}")
COUNT=${#COMMITS_TO_PUSH[@]}
log "需要推送的提交数：$COUNT (from index $START_INDEX)"

if (( COUNT == 0 )); then
  log "没有需要推送的提交，退出"
  exit 0
fi

# 将提交分块，每块只需推最后一个 commit
TASKS=()
idx=0
while (( idx < COUNT )); do
  end=$(( idx + BATCH_SIZE - 1 ))
  (( end >= COUNT )) && end=$(( COUNT - 1 ))
  TASKS+=("${COMMITS_TO_PUSH[$end]}")
  idx=$(( end + 1 ))
done

TOTAL_TASKS=${#TASKS[@]}
log "生成批次数量：$TOTAL_TASKS (BATCH_SIZE=$BATCH_SIZE)"

# 若任务比线程少，缩减线程数
if (( TOTAL_TASKS < JOBS )); then
  log "任务数 $TOTAL_TASKS 少于请求线程 $JOBS，调整 JOBS=$TOTAL_TASKS"
  JOBS=$TOTAL_TASKS
fi

# 推送函数（带重试与退避）
push_commit() {
  local commit="$1"
  local attempt=1
  local s e ms

  while (( attempt <= MAX_RETRY )); do
    s=$(date +%s%3N)
    echo "[Thread $$] 推送 $commit (尝试 $attempt)" | tee -a "$LOG_FILE"

    if git push --force "$NEW_REMOTE" "$commit:refs/heads/$TARGET_BRANCH" 2>&1 | tee -a "$LOG_FILE"; then
      e=$(date +%s%3N)
      ms=$(( e - s ))
      echo "[Thread $$] 成功：$commit 用时 ${ms}ms" | tee -a "$LOG_FILE"
      return 0
    fi

    e=$(date +%s%3N)
    echo "[Thread $$] 失败：$commit 用时 $(( e - s ))ms - 重试中" | tee -a "$LOG_FILE"

    # 限流检测（简单）
    last_err=$(tail -n 50 "$LOG_FILE")
    if echo "$last_err" | grep -qiE "429|rate limit|quota|rate limited"; then
      backoff=$(( BASE_BACKOFF * attempt ))
      echo "[Thread $$] 检测到限流，等待 ${backoff}s 后重试" | tee -a "$LOG_FILE"
      sleep "$backoff"
    else
      sleep "$BASE_BACKOFF"
    fi

    (( attempt++ ))
  done

  echo "[Thread $$] FATAL: $commit 推送失败" | tee -a "$LOG_FILE"
  return 1
}

# 并行执行任务（信号量实现）
log "开始并行推送（JOBS=$JOBS）..."
(
  SEM="/tmp/.gpusher-$$.fifo"
  mkfifo "$SEM"
  exec 9<>"$SEM"
  rm "$SEM"
  # 初始化令牌
  for ((i=0;i<JOBS;i++)); do echo >&9; done

  for commit in "${TASKS[@]}"; do
    read -u9
    {
      push_commit "$commit"
      echo >&9
    } &
  done

  wait
)

# 最终确保分支指向最后一个最高 commit（强制覆盖）
FINAL="${TASKS[-1]}"
log "最终保证分支指向最后提交 $FINAL（强制 push）"
git push --force "$NEW_REMOTE" "$FINAL:refs/heads/$TARGET_BRANCH" 2>&1 | tee -a "$LOG_FILE" || {
  log "最终 push 失败，请检查网络/权限"
  exit 1
}

# 记录断点为 FINAL
echo "$FINAL" > "$STATE_FILE"

log "==============================================="
log "🎉 并行迁移完成：已生成批次 $TOTAL_TASKS（推送 $COUNT 提交）"
log "==============================================="